@charset "utf-8";

:root { --color-primary: #32b8c6; --color-secondary: #8b5cf6; --color-accent: #ec4899; --color-bg-dark: #0f172a; --color-bg-card: #1e293b; --color-text-primary: #f1f5f9; --color-text-secondary: #cbd5e1; --color-border: #334155; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif; background-color: var(--color-bg-dark); color: var(--color-text-primary); line-height: 1.6; overflow-x: hidden; }

nav { position: fixed; top: 0px; width: 100%; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(10px); z-index: 1000; padding: 1rem 2rem; border-bottom: 1px solid var(--color-border); }

.nav-container { max-width: 1200px; margin: 0px auto; display: flex; justify-content: space-between; align-items: center; }

.logo { font-size: 1.8rem; font-weight: 700; background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; -webkit-text-fill-color: transparent; background-clip: text; }

.nav-links { display: flex; gap: 2rem; list-style: none; }

.nav-links a { color: var(--color-text-secondary); text-decoration: none; transition: color 0.3s; font-weight: 500; }

.nav-links a:hover { color: var(--color-primary); }

.nav-toggle { display: none; background: none; border: none; color: var(--color-text-primary); font-size: 1.5rem; cursor: pointer; }

.hero { margin-top: 60px; min-height: calc(-60px + 100vh); background: linear-gradient(135deg, rgb(15, 23, 42) 0%, rgb(30, 27, 75) 50%, rgb(15, 23, 42) 100%); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; padding: 2rem; }

.hero::before { content: ""; position: absolute; width: 400px; height: 400px; background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%); border-radius: 50%; opacity: 0.1; top: 10%; left: -5%; animation: 6s ease-in-out 0s infinite normal none running float; }

.hero::after { content: ""; position: absolute; width: 300px; height: 300px; background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%); border-radius: 50%; opacity: 0.1; bottom: 10%; right: -5%; animation: 8s ease-in-out 0s infinite reverse none running float; }

@keyframes float { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(30px); }
}

.hero-content { text-align: center; position: relative; z-index: 10; }

.hero-image { max-width: 500px; width: 100%; margin-bottom: 2rem; border-radius: 20px; box-shadow: rgba(50, 184, 198, 0.2) 0px 20px 60px; animation: 0.8s ease-out 0s 1 normal none running slideUp; }

@keyframes slideUp { 
  0% { opacity: 0; transform: translateY(40px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.hero h1 { font-size: clamp(2.5rem, 8vw, 4.5rem); margin-bottom: 1rem; background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; -webkit-text-fill-color: transparent; background-clip: text; animation: 0.8s ease-out 0s 1 normal none running slideUp; }

.hero p { font-size: 1.3rem; color: var(--color-text-secondary); margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto; animation: 0.8s ease-out 0.1s 1 normal both running slideUp; }

.cta-buttons { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; animation: 0.8s ease-out 0.2s 1 normal both running slideUp; }

.btn { padding: 0.875rem 2.5rem; font-size: 1rem; font-weight: 600; border: none; border-radius: 50px; cursor: pointer; transition: 0.3s; text-decoration: none; display: inline-block; }

.btn-primary { background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); color: white; box-shadow: rgba(50, 184, 198, 0.3) 0px 10px 30px; }

.btn-primary:hover { transform: translateY(-2px); box-shadow: rgba(50, 184, 198, 0.4) 0px 15px 40px; }

.btn-secondary { background: transparent; color: var(--color-primary); border: 2px solid var(--color-primary); }

.btn-secondary:hover { background: rgba(50, 184, 198, 0.1); }

section { max-width: 1200px; margin: 0px auto; padding: 5rem 2rem; }

.section-title { font-size: 2.5rem; text-align: center; margin-bottom: 3rem; background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; -webkit-text-fill-color: transparent; background-clip: text; }

.about { background: rgba(30, 41, 59, 0.5); }

.about-content { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }

.about-text h3 { font-size: 1.5rem; margin-bottom: 1rem; color: var(--color-primary); }

.about-text p { margin-bottom: 1.5rem; color: var(--color-text-secondary); line-height: 1.8; }

.members { background: transparent; }

.members-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }

.member-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 15px; padding: 2rem; text-align: center; transition: 0.3s; cursor: pointer; }

.member-card:hover { border-color: var(--color-primary); transform: translateY(-5px); box-shadow: rgba(50, 184, 198, 0.2) 0px 10px 30px; }

.member-avatar { width: 120px; height: 120px; margin: 0px auto 1.5rem; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 3rem; }

.member-name { font-size: 1.3rem; font-weight: 600; margin-bottom: 0.5rem; }

.member-role { color: var(--color-primary); font-size: 0.95rem; margin-bottom: 1rem; }

.music { background: rgba(30, 41, 59, 0.5); }

.player { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 15px; padding: 2rem; margin-bottom: 2rem; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }

.player-icon { width: 80px; height: 80px; background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 2rem; flex-shrink: 0; }

.player-info { flex: 1 1 0%; min-width: 250px; }

.player-title { font-weight: 600; margin-bottom: 0.5rem; }

.player-artist { color: var(--color-text-secondary); font-size: 0.9rem; }

.events { background: transparent; }

.event-card { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 15px; padding: 2rem; margin-bottom: 1.5rem; display: flex; gap: 2rem; align-items: flex-start; transition: 0.3s; }

.event-card:hover { border-color: var(--color-primary); box-shadow: rgba(50, 184, 198, 0.1) 0px 10px 30px; }

.event-date { background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); color: white; padding: 1rem; border-radius: 10px; text-align: center; min-width: 100px; font-weight: 600; }

.event-date-day { font-size: 1.8rem; }

.event-date-month { font-size: 0.85rem; opacity: 0.9; }

.event-info h3 { color: var(--color-primary); margin-bottom: 0.5rem; }

.event-info p { color: var(--color-text-secondary); margin-bottom: 0.5rem; }

.contact { background: rgba(30, 41, 59, 0.5); }

.contact-form { max-width: 600px; margin: 0px auto; }

.form-group { margin-bottom: 1.5rem; }

.form-group label { display: block; margin-bottom: 0.5rem; font-weight: 500; }

.form-group input, .form-group textarea { width: 100%; padding: 0.75rem 1rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 8px; color: var(--color-text-primary); font-family: inherit; transition: 0.3s; }

.form-group input:focus, .form-group textarea:focus { outline: none; border-color: var(--color-primary); box-shadow: rgba(50, 184, 198, 0.1) 0px 0px 0px 3px; }

.form-group textarea { resize: vertical; min-height: 120px; }

.form-submit { width: 100%; padding: 1rem; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); color: white; border: none; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; transition: 0.3s; }

.form-submit:hover { transform: translateY(-2px); box-shadow: rgba(50, 184, 198, 0.3) 0px 10px 30px; }

footer { background: var(--color-bg-card); border-top: 1px solid var(--color-border); padding: 3rem 2rem; text-align: center; color: var(--color-text-secondary); }

.social-links { display: flex; gap: 1.5rem; justify-content: center; margin-bottom: 2rem; }

.social-link { width: 40px; height: 40px; border: 1px solid var(--color-border); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--color-primary); text-decoration: none; transition: 0.3s; }

.social-link:hover { background: var(--color-primary); color: white; border-color: var(--color-primary); }

.footer-content { max-width: 1200px; margin: 0px auto; }

@media (max-width: 768px) {
  .nav-links { display: none; }
  .nav-toggle { display: block; }
  .about-content { grid-template-columns: 1fr; }
  .event-card { flex-direction: column; }
  .cta-buttons { flex-direction: column; }
  .btn { width: 100%; }
  section { padding: 3rem 1.5rem; }
  .section-title { font-size: 2rem; }
}

.message { display: none; padding: 1rem; background: rgba(34, 197, 94, 0.1); border: 1px solid rgb(34, 197, 94); border-radius: 8px; color: rgb(134, 239, 172); text-align: center; margin-bottom: 1rem; }

.message.show { display: block; }
